<%= turbo_stream_from @quiz %>
<%= turbo_stream_from @player %>
<div id="quiz" class="h-full">
  <% if @quiz.ended? %>
    <% if @quiz.winner == @player %>
      <%= render "quizzes/winner" %>
    <% else %>
      <%= render "quizzes/ended", quiz: @quiz %>
    <% end %>
  <% elsif @quiz.currently_calling_player == @player %>
    <%= render "called" %>
  <% elsif @player&.buzzed_at.present? %>
    <div class="text-center mb-6">
      <h1 class="<%= h1_classes %>">You have buzzed in!</h1>
      <p>But were you quickest?</p>
    </div>
  <% elsif @player.locked_out? %>
    <h2 class="<%= h2_classes %>">Please wait for the next question.</h1>
  <% else %>
    <%= render "buzz", quiz: @quiz, player: @player %>
  <% end %>
</div>
