<% if @quiz.ended? %>
  <h1 class="<%= h1_classes %>">Quiz Finished</h1>
  <h2 class="<%= h2_classes %>">Scoreboard:</h2>
  <ul>
    <% @quiz.players.order(score: :desc).each do |player| %>
      <li><%= player.name %> - <%= player.score %> points</li>
    <% end %>
  </ul>
<% else %>
  <%= image_tag "logo.png", alt: "QuizBiscuit Logo", class: "mx-auto max-h-48" %>

  <h1 class="text-4xl mb-4 font-bold">"<%= @quiz.name %>" is ready</h1>

  <p class="mb-6">
    To add big screen display, go to this address on the big screen:
    <a href="<%= spectate_quiz_url(@quiz) %>" class="text-sky-400 underline"><%= spectate_quiz_url(@quiz) %></a>
  </p>

  <p class="mb-6">
    Share the join link with players:
    <a href="<%= @join_link %>" class="text-sky-400 underline"><%= @join_link %></a>
  </p>

  <%= turbo_stream_from @quiz %>
  <div id="players_joined">
    <%= render "shared/players_joined", quiz: @quiz %>
  </div>

  <%= button_to 'Start Quiz', start_host_quiz_path, class: button_classes %>
<% end %>
